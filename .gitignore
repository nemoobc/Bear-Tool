# dev artifacts
logs/
# browserstack-node-sdk writes its own run logs here (see browserstack.yml).
log/
# Transient configs the BrowserStack SDK regenerates on every run.
browserstackSetupConfig.json
playwright-browserstack-sdk.config.cjs
playwright-browserstack-sdk.config.temp.json
# CI-downloaded APK and the screenshots tools/apk-test.mjs produces.
apk/
artifacts/

# verification screenshots produced by the browser-driven audit runs
shots/

# Browser test harnesses. These are copied into the repo only while a run needs
# them, they are __-named scaffolding rather than product code, and one of them
# hardcodes an OpenSea API key. box sync excludes __* from the tarball, so nothing
# tracked ever carries them.
__*.html
__*.mjs
__*
dist/
