# Copy to .env and fill in what you need. .env is git-ignored — never commit it.

# WalletConnect / Reown relay project id (public by design, origin-allowlisted).
# Free signup: https://dashboard.reown.com — no per-dApp approval required.
# Falls back to the bundled id when unset, so an empty file is fine.
VITE_WC_PROJECT_ID=

# BrowserStack credentials (README §Test cross-device run)
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
