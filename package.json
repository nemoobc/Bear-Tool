{
  "name": "bear-tool",
  "version": "1.0.0",
  "description": "Bear Tool — self-custody cartoon crypto wallet. All EVM networks, EIP-7702 suite. 100% client-side.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node --test tests/*.test.js",
    "test:fork": "node --test --test-concurrency=1 --test-timeout=600000 tests/fork/*.test.js",
    "test:fork:net": "node --test --test-concurrency=1 --test-timeout=600000 tests/fork/*.test.js",
    "test:dex-pump": "node tests/dex-pump-e2e.mjs",
    "check": "node tools/check.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "test:e2e:browserstack": "BEAR_E2E_BROWSERSTACK=1 BEAR_BASE_URL=http://localhost:8080 node tools/e2e.mjs",
    "test:e2e-wc": "node tests/e2e-wc.mjs",
    "verify": "npm run test:all",
    "test:all": "npm run check && npm test && npm run test:fork && npm run test:e2e",
    "test:live": "node --test --test-concurrency=1 --test-timeout=240000 tests/*.live.js",
    "test:dex-onchain": "node tests/dex-onchain-e2e.mjs"
  },
  "dependencies": {
    "@reown/walletkit": "^1.6.0",
    "@walletconnect/core": "^2.25.0",
    "ethers": "6.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^5.1.0",
    "browserstack-node-sdk": "^1.71.4",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.50.0",
    "solc": "^0.8.37",
    "vite": "^7.1.0"
  },
  "overrides": {
    "@noble/hashes": "1.8.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.32.6": true
  }
}
