{
  "name": "bear-tool",
  "version": "1.0.0",
  "description": "Bear Tool — self-custody cartoon crypto wallet. All EVM networks, EIP-7702 suite. 100% client-side.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:fork": "node --test --test-concurrency=1 --test-timeout=150000 tests/fork/*.test.js",
    "test:fork:net": "node --test --test-concurrency=1 --test-timeout=150000 tests/fork/*.test.js",
    "check": "for f in js/*.js; do node --check \"$f\"; done",
    "test:e2e": "bash tests/e2e/run.sh",
    "verify": "npm run check && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ethers": "6.17.0",
    "playwright": "^1.63.0"
  }
}
