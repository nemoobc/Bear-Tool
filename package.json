{
  "name": "bear-tool",
  "version": "1.0.0",
  "description": "Bear Tool — self-custody cartoon crypto wallet. All EVM networks, EIP-7702 suite. 100% client-side.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:fork": "node --test --test-concurrency=1 --test-timeout=600000 tests/fork/*.test.js",
    "test:fork:net": "node --test --test-concurrency=1 --test-timeout=600000 tests/fork/*.test.js",
    "check": "node tools/check.mjs",
    "test:e2e": "node tools/e2e.mjs",
    "verify": "npm run test:all",
    "test:all": "npm run check && npm test && npm run test:fork && npm run test:e2e",
    "test:live": "node --test --test-concurrency=1 --test-timeout=240000 tests/*.live.js"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "ethers": "6.17.0",
    "playwright": "^1.63.0"
  }
}
